{
  "name": "aa",
  "version": "1.5.1",
  "description": "Code quality tools and development workflow automation: audits, refactoring analysis, smart commits, and beads issue tracking",
  "author": {
    "name": "seethroughdev",
    "url": "https://github.com/seethroughdev"
  },
  "repository": "https://github.com/seethroughdev/cc-dev-workflow",
  "license": "MIT",
  "keywords": [],
  "hooks": {
    "SessionStart": [
      {
        "hooks": []
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": []
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "terminal-notifier -title 'Claude Code' -message 'Done'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "terminal-notifier -title 'Claude Code' -message 'Waiting for response'"
          }
        ]
      }
    ]
  }
}
